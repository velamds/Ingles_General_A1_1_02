, "id": 1, "correct": 1, "_data": [{"type": "text", "content": "like"}]}], "id": 4, "_data": [{"type": "question", "contents": [{"type": "audio", "content": "engenn2le02ob07re5aud06"}, {"type": "text", "content": "We"}]}, {"type": "post_question", "contents": {"type": "", "content": "the same things but we are so different!"}}, {"type": "objective", "content": "secondary_3"}]}], "type": "SFL", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Let's talk about actions!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 3"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Listen to the audio. Move the words from the box to correctly complete the sentences."}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}, {"type": "template_override", "content": 1}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Meeting New People"}, {"type": "unit_name", "content": "Same but Different"}, {"type": "position", "content": 7}, {"type": "origin", "content": "scholar > How to Master Small Talk > Meeting Peter"}, {"type": "lesson", "content": 2}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Exchange personal information about the home and family in communicative situations."}, {"type": "secondary_1", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_2", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_5", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level. "}, {"type": "secondary_6", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands key information in written texts about the communicative topics related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Adverbs of Frequency "}, {"type": "describer", "content": "You use words like<span class=\"italic\">  always, usually, often, sometimes, rarely</span> and <span class=\"italic\"> never</span> to talk about how often you do an activity."}, {"type": "text", "content": "You use <span class=\"italic\"> How often ... ?</span> to find out how frequently a person does an activity."}, {"type": "text", "content": "You usually use adverbs of frequency with the Simple Present tense."}, {"type": "table", "content": "{\"rows\":\"02\",\"columns\":\"07\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"100%  \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"80-95%\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  75% \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"   50% \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"40-45% \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" 20%  \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"0%  \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"always\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"usually\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"often\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"sometimes\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"occasionally\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rarely \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"never\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "I always watch the morning news."}, {"type": "example", "content": "I often read the newspaper."}, {"type": "example", "content": "Occasionally, I take the bus."}, {"type": "example", "content": "I rarely watch the news."}, {"type": "example", "content": "I never take the bus."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Free Time Activities"}, {"type": "describer", "content": "You use these words and phrases to talk about activities you do for fun in your free time. Free time activities are also called hobbies."}, {"type": "text", "content": "Use these questions to ask about free time activities."}, {"type": "text", "content": "<span class=\"italic\">What do you like to do in your free time?  <br />What are your hobbies? </span>"}, {"type": "table", "content": "{\"rows\":\"04\",\"columns\":\"03\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Verb </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Noun </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"play\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a sport\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I like to play soccer. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"read\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a book or newspaper\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I like to read a book. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"watch\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"TV or movies\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> I like to watch TV. </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"strong\">John</span>:     What do you like to do  in your free time, Sara?"}, {"type": "example", "content": "<span class=\"strong\">Sara</span>:     I like to listen to music. What are your hobbies, John?"}, {"type": "example", "content": "<span class=\"strong\">John</span>:     I like to play soccer."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "book "}, {"type": "definition", "content": "a set of pages put together with one cover on the front and one at the back"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I like to read books."}, {"type": "audio", "content": "engenn2le02ob07aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use to talk about free time activities."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "different "}, {"type": "definition", "content": "not the same "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: We like to play different sports. "}, {"type": "audio", "content": "engenn2le02ob07aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to listen to "}, {"type": "definition", "content": "to give attention to what a person is saying "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I listen to music every day."}, {"type": "audio", "content": "engenn2le02ob07aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "newspaper "}, {"type": "definition", "content": "a document with the daily news on big sheets of paper "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: I read the \"New York Times\" newspaper."}, {"type": "audio", "content": "engenn2le02ob07aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "same "}, {"type": "definition", "content": "identical; not different "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: We have the same interests."}, {"type": "audio", "content": "engenn2le02ob07aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to take the bus "}, {"type": "definition", "content": "to ride on the bus, to go from one place to another  "}, {"type": "part_speech", "content": "(verb )"}, {"type": "example", "content": "Example: I take the bus to work every day."}, {"type": "audio", "content": "engenn2le02ob07aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to drive "}, {"type": "definition", "content": "to move from one place to another in a vehicle  "}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: I rarely drive to work."}, {"type": "audio", "content": "engenn2le02ob07aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to watch "}, {"type": "definition", "content": "to look at something for a period of time "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I like to watch the news."}, {"type": "audio", "content": "engenn2le02ob07aud08"}]}, {"type": "background_image", "content": "engenn2le02ob07re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Ask your classmates their names. Write down their names."}, {"type": "text", "content": "Ask what they do in their free time. Write down the activity."}, {"type": "text", "content": "Ask how often they do this activity per week. Write down the answer."}, {"type": "text", "content": "Tell the class who is similar and who is different."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I ask what people do in their free time."}, {"type": "text", "content": "I talk about my free time activities."}, {"type": "text", "content": "I ask <span class=\"italic\">Wh-</span> questions to learn about classmates."}, {"type": "text", "content": "I tell the class who is similar and who is different."}]}]}