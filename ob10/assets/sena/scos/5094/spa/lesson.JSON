ple </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"and\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"join same ideas\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Tom likes to watch and play sports. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"or\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"show choice\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> You can take the bus or drive.  </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"but\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"show contrast\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> John likes to watch the news, but he doesn't like to read the newspaper. </span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "game "}, {"type": "definition", "content": "a competition of a sport "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Let's go to a hockey game tonight."}, {"type": "audio", "content": "engenn2le02ob10aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " You  use these words to cancel plans because of bad weather."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "soccer "}, {"type": "definition", "content": "a sport played between two teams who try to kick a ball into the other team's goal "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Soccer is a popular sport all over the world."}, {"type": "audio", "content": "engenn2le02ob10aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "team "}, {"type": "definition", "content": "a group of people who work together or play a sport as a group"}, {"type": "part_speech", "content": "(noun)"}, {