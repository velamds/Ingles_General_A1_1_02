""}], "id": 0, "correct": 0}, {"selected": 0, "_data": [{"type": "text", "content": "have to"}], "id": 1, "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": "I"}]}, {"type": "post_question", "contents": {"type": "", "content": "work, but I can leave early."}}, {"type": "objective", "content": "secondary_2"}], "id": 2}, {"responses": [{"selected": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "correct": 0}, {"selected": 0, "_data": [{"type": "text", "content": "When"}], "id": 1, "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}, {"type": "post_question", "contents": {"type": "", "content": "do you want to go see a film? I'm a big film buff!"}}, {"type": "objective", "content": "secondary_2"}], "id": 3}], "type": "TYP", "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "What is the question? Let's find out!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Activity 2"}]}, {"type": "feedback", "content": {"correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "allowed_attempts": 2}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Read the sentences.</span> <span class=\"bullet\">Type in the missing words.</span> </span><span class=\"bullet\">Choose from these words: <span class=\"product-color-text\">about</span>, <span class=\"product-color-text\">what</span>, <span class=\"product-color-text\">when</span>, <span class=\"product-color-text\">have to</span> or <span class=\"product-color-text\">want to</span>. <span class=\"bullet\">Use capital letters where necessary.</span> "}, {"type": "text", "content": "You have 2 attempts to submit your answers."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "id": 0, "_data": [], "contents": [{}], "template_override": 1}, {"title": "", "id": 1, "template_override": 1, "type": "audio", "_data": [], "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn2le02ob02re2aud01", "coverimg": "engenn2le02ob02re2img05.jpg", "images": [{"text": "", "image": "engenn2le02ob02re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">John</span>:      Hey, Sally! It's John. <br />\n<span class=\"strong\">Sally</span>:      Hi, John. What's new? <br />\n<span class=\"strong\">John</span>:      I have two movie tickets. Are you interested?", "image": "engenn2le02ob02re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Sally</span>:      A movie? That sounds like fun. I am a big film buff. <br />\n<span class=\"strong\">John</span>:      Really? \t<br />\n<span class=\"strong\">Sally</span>:      Yeah! I watch 3 movies every week. When do you want to go see a film?", "image": "engenn2le02ob02re2img01.jpg", "time": "19000", "id": 2}, {"text": "<span class=\"strong\">John</span>:      How about Tuesday evening, March 17th? <br />\n<span class=\"strong\">Sally</span>:      Tuesday ... March 17th ... let me look at my calendar ... Oh ... I can't.\n<br/><span class=\"strong\">John</span>:      Why? What is it?", "image": "engenn2le02ob02re2img05.jpg", "time": "33000", "id": 3}, {"text": "<span class=\"strong\">Sally</span>:      I have a yoga class on Tuesday evenings. <br />\n<span class=\"strong\">John</span>:      Oh! Well, let's go on Thursday evening. <br />\n<span class=\"strong\">Sally</span>:      Sorry. I have an appointment.", "image": "engenn2le02ob02re2img05.jpg", "time": "52300", "id": 4}, {"text": "<span class=\"strong\">John</span>:      What about Saturday, then? <br />\n<span class=\"strong\">Sally</span>:      Saturday ... I have to work ... but that's my birthday! <br />\n<span class=\"strong\">John</span>:      Alright! Let's talk on Friday. I'll call you.", "image": "engenn2le02ob02re2img05.jpg", "time": "63600", "id": 5}]}}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Meeting New People"}, {"type": "unit_name", "content": "What Is It?"}, {"type": "position", "content": 2}, {"type": "origin", "content": "scholar > How to Master Small Talk > Greetings"}, {"type": "lesson", "content": 2}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people, their likes and dislikes, homes or countries in communicative situations."}, {"type": "secondary_1", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_3", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_4", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands key information in written texts about the communicative topics related to this level.Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  "}, {"type": "secondary_8", "content": "Understands key information in written texts about the communicative topics related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "  Wh-Question:  When  "}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use the questions <span class=\"italic\">When is \u2026 ?</span> or <span class=\"italic\">When do \u2026 ?</span> to get specific information about the time, day and date of an event. "}, {"type": "example", "content": "When is the party? "}, {"type": "example", "content": "When do you want to see a film?"}, {"type": "table", "content": "{\"rows\":\"02\",\"columns\":\"02\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Ask </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Say </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">When is the party?  <br /> When do you want to go see the film? </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">It is on May 15th. <br /> Let's go tomorrow. </span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Dates and Numbers"}, {"type": "describer", "content": "A date is the specific day of the month. You can say a date in different ways. "}, {"type": "text", "content": "Look at the chart below for different endings for different numbers."}, {"type": "table", "content": "{\"rows\":\"01\",\"columns\":\"03\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"January 1<br /> February 2<br /> March 3<br /> April 4<br /> May 5<br /> June 6<br /> July 7<br /> August 8<br /> September 9<br /> October 10<br /> November 11<br /> November 30<br /> December 12<br /> December 20\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Jan. first<br /> Feb. second<br /> Mar. third<br /> Apr. fourth<br /> May fifth<br /> Jun. sixth<br /> Jul. seventh<br /> Aug. eighth<br /> Sep. ninth<br /> Oct. tenth<br /> Nov. eleventh<br /> Nov. thirtieth<br /> Dec. twelfth<br /> Dec. twentieth\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Jan. 1st<br /> Feb. 2nd<br /> Mar. 3rd<br /> Apr. 4th<br /> May 5th<br /> Jun. 6th<br /> Jul. 7th<br /> Aug. 8th <br />Sep. 9th <br />Oct. 10th<br /> Nov. 11th<br /> Nov. 30th<br /> Dec. 12th<br /> Dec. 20th\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "<span class=\"strong\">Jeff</span>:  When is your birthday? <br /><span class=\"strong\">Joe</span>:  It's December 28th."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "calendar "}, {"type": "definition", "content": "a chart showing the days, months, and dates of the year "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: According to my calendar, I'm busy on April 1st. "}, {"type": "audio", "content": "engenn2le02ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " You use these words to talk about events."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "date "}, {"type": "definition", "content": "the number of a day in the month "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: What is the date on Friday?"}, {"type": "audio", "content": "engenn2le02ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "appointment "}, {"type": "definition", "content": "a fixed time to meet another person "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I have a doctor's appointment at 10:30 this morning."}, {"type": "audio", "content": "engenn2le02ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "day "}, {"type": "definition", "content": "a period of twenty-four hours; morning to night "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: <span class=\"strong\">Jamie</span>: What day is it?<br /> <span class=\"strong\">Tom</span>: It's Wednesday."}, {"type": "audio", "content": "engenn2le02ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "week "}, {"type": "definition", "content": "a period of seven days - Monday to Sunday "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I have a lot of work this week."}, {"type": "audio", "content": "engenn2le02ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "month "}, {"type": "definition", "content": "a period of thirty or thirty-one days "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are twelve months in a year."}, {"type": "audio", "content": "engenn2le02ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to see "}, {"type": "definition", "content": " to watch a film; to look around and notice things with your eyes "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Do you want to see a movie?"}, {"type": "audio", "content": "engenn2le02ob02aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to want "}, {"type": "definition", "content": "to wish for things to happen  "}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: I want a big cake on my birthday."}, {"type": "audio", "content": "engenn2le02ob02aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "I can't "}, {"type": "definition", "content": "used to say a person cannot do an activity or action"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I can't come to the movies tomorrow. I have to work."}, {"type": "audio", "content": "engenn2le02ob02aud09"}]}, {"type": "background_image", "content": "engenn2le02ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Work with a partner. Make plans to go to a movie. Write down your conversation."}, {"type": "text", "content": "Use dates, days, and months."}, {"type": "text", "content": "Write 3 lines for each partner."}, {"type": "text", "content": "Practice your conversation."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I use <span class=\"italic\">Wh-</span> questions like <span class=\"italic\">When is ... ?</span>, <span class=\"italic\">When do you .. ?</span>"}, {"type": "text", "content": "I use vocabulary for dates, days and months."}, {"type": "text", "content": "I write sentences about movies."}]}]}